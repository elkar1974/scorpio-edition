<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MAU•SCORPIO•EDITION</title>
    <style>
        body { 
            margin: 0; padding: 0; font-family: 'Arial', sans-serif; 
            background-image: url('logo_scorpio.png');
            background-size: cover; background-position: center;
            background-repeat: no-repeat; background-attachment: fixed;
            background-color: #000; color: #ffffff; text-align: center; 
            min-height: 100vh; display: flex; flex-direction: column;
            align-items: center; justify-content: center; position: relative;
        }
        body::before {
            content: ""; position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.92); z-index: 0;
        }
        .container { padding: 20px; position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; }
        
        /* Margine ridotto per accogliere uniformemente le due righe di testo sottostanti */
        .logo-main { width: 80vw; max-width: 400px; height: auto; margin-bottom: 20px; }
        
        .lang-switcher { display: flex; gap: 15px; margin-top: 25px; flex-wrap: wrap; justify-content: center; }
        .lang-switcher a img { 
            width: 50px; height: auto; border: 2px solid transparent; 
            border-radius: 4px; transition: transform 0.2s; cursor: pointer;
        }
        .lang-switcher a:hover img { transform: scale(1.15); border-color: #ffcc00; }

        /* AGGIUNTA: Nuovo stile professionale per Nick e ID impaginati su due righe */
        .profile-info {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 15px;
            cursor: default;
        }
        .profile-nick {
            color: #ffcc00;
            font-size: 1.5em;
            letter-spacing: 3px;
            font-weight: bold;
            text-shadow: 0 0 10px rgba(255, 204, 0, 0.4);
        }
        .profile-id {
            color: #ffffff;
            font-size: 1.1em;
            letter-spacing: 2px;
            font-weight: normal;
            opacity: 0.95;
        }
        .profile-id span {
            color: #ffcc00;
            font-weight: bold;
        }

        .welcome-text {
            margin-top: 25px; color: #ffcc00; font-size: 1.8em;
            letter-spacing: 3px; text-transform: uppercase; font-weight: bold;
            text-shadow: 0 0 10px rgba(255, 204, 0, 0.5); cursor: default;
        }
    </style>
</head>
<body>
    <div class="container">
        <img src="logo_scorpio.png" class="logo-main" alt="MAU•SCORPIO•EDITION">
        
        <!-- AGGIUNTA: Nick e ID impaginati su due righe, statici e non cliccabili -->
        <div class="profile-info">
            <div class="profile-nick">MAU•SCORPIO•EDITION</div>
            <div class="profile-id"><span>ID:</span> 62084185726</div>
        </div>

        <div class="lang-switcher">
            <a href="catalogo.html?lang=it#menu1"><img src="https://flagcdn.com/w40/it.png" alt="Italiano"></a>
            <a href="catalogo.html?lang=es#menu1"><img src="https://flagcdn.com/w40/es.png" alt="Español"></a>
            <a href="catalogo.html?lang=en#menu1"><img src="https://flagcdn.com/w40/gb.png" alt="English"></a>
            <a href="catalogo.html?lang=fr#menu1"><img src="https://flagcdn.com/w40/fr.png" alt="Français"></a>
            <a href="catalogo.html?lang=de#menu1"><img src="https://flagcdn.com/w40/de.png" alt="Deutsch"></a>
        </div>
        <div class="welcome-text">WELCOME</div>
    </div>
</body>
</html>